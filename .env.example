# MongoDB connection string for the codebase vector search
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# SerpAPI key for live web search tool
SERPAPI_API_KEY=your_serpapi_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: if you use a different MongoDB database or collection, override in code accordingly
# MONGO_DB_NAME=agent_db
# MONGO_COLLECTION_NAME=codebase_context
